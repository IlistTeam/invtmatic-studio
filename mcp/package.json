{
  "name": "invtmatic-studio-mcp",
  "version": "0.7.1",
  "description": "INVTmatic Studio project development, simulation and explicit TM751 physical commissioning MCP",
  "main": "dist/invt-server.js",
  "bin": {
    "invtmatic-studio-mcp": "dist/invt-server.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:invt",
    "build:invt": "tsc && node -e \"require('fs').cpSync('src/scripts','dist/scripts',{recursive:true})\"",
    "test": "npm run test:invt",
    "test:invt": "node --test tests/invt-session.test.cjs",
    "test:guards": "python tests/invt-runtime-guards.py && python tests/invt-debugger-guards.py && python tests/invt-advanced-guards.py && python tests/invt-hardware-discovery.py && python tests/invt-plc-guards.py",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codesys",
    "mcp",
    "plc",
    "automation",
    "persistent",
    "ui"
  ],
  "author": "luke-harriman",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlistTeam/invtmatic-studio.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/IlistTeam/invtmatic-studio#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^11.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.1",
    "typescript": "^5.5.3"
  },
  "private": true
}
